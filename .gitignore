# 虛擬環境
venv/
.venv/
env/
.env

# Python 快取檔案
__pycache__/
*.py[cod]
*$py.class

# 日誌檔案
logs/
*.log

# 暫存檔與輔助腳本
answers.json
update_readme_queries.py

# 評估產出（每跑一次多兩個檔，只留手邊最新的即可）
# 2026-08-20 分類搬遷後集中在 eval/results/
eval/results/
eval_report_*.txt
eval_result_*.json

# 表向量快取（key 是表文件雜湊，schema 一改就自動重算，不該進版控）
.table_vectors.json

# IDE / 編輯器相關
.vscode/
.idea/
*.swp
*.swo

# 其他
.DS_Store

# 離線評估用的欄位向量快取（eval_column_recall.py 自動重建）
.column_vectors.json

# 候選目錄的欄位提示向量快取（column_hints.py 自動重建，約 24 MB）
.column_hint_vectors.json

# 探針的向量快取（12MB，可重生）
tools/probes/.*_cache.json
tools/probes/.pure_top1.json
